# API keys for integration tests
# Copy this file to .env and fill in real values to run integration tests.
# Tests will be skipped if credentials are missing.

# Cloudflare API credentials
CLOUDFLARE_API_KEY=your_api_key_here
CLOUDFLARE_API_EMAIL=your_email@example.com
CLOUDFLARE_ZONE_ID=your_zone_id_here

# Mandrill API credentials
MANDRILL_API_KEY=your_mandrill_api_key_here
